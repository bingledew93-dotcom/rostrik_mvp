# Phase 6: bumped to iOS 15.5 — google_mlkit_text_recognition 0.15.1 pulls
# GoogleMLKit/TextRecognition ~> 9.0 (and MLKitVision ~> 10.0), whose podspecs
# declare `s.platform = :ios, '15.5'`. Anything lower fails `pod install`.
platform :ios, '15.5'

# CocoaPods analytics sends network stats on every build, slowing them down.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Force every pod (including the ML Kit / uCrop transitive pods) up to
      # the 15.5 floor so a pod that inherited a lower target can't break the
      # build. Mirrors the value set in Runner.xcodeproj/project.pbxproj.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

      # permission_handler_apple compiles EVERY permission group out by
      # default (each strategy .m is `#if PERMISSION_X ... #else <empty
      # @implementation> #endif`) — without this, Permission.notification
      # silently never calls UNUserNotificationCenter, so the onboarding
      # toggle can never grant it. Only enabling what main.dart /
      # permissions_screen.dart actually call.
      if target.name == 'permission_handler_apple'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_NOTIFICATIONS=1'
      end
    end
  end
end
