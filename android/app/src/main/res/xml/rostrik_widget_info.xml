<?xml version="1.0" encoding="utf-8"?>
<!-- Widget metadata. Defaults to a 4x2 placement (targetCell) but resizes down
     to 2x2 (minWidth/Height ≈ 2 cells) and up. previewLayout renders the real
     card in the picker on Android 12+, with the launcher icon as a fallback
     preview below that. updatePeriodMillis is the OS re-draw cadence (min 30m);
     the authoritative refresh is the app pushing fresh data via WidgetService. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/rostrik_widget"
    android:minHeight="110dp"
    android:minWidth="110dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/rostrik_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
