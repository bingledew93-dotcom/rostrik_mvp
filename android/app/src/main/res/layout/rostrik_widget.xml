<?xml version="1.0" encoding="utf-8"?>
<!-- Rostrik home-screen widget (Phase 2). A glanceable dark card mirroring the
     Dashboard Hero Card: a colour accent bar (tinted per shift type by
     RostrikWidgetProvider), a coloured badge line, the big countdown/status,
     and a secondary timestamp. Only RemoteViews-supported views are used
     (LinearLayout / TextView / ImageView) so it renders inside a widget host.
     The whole card is one tap target that deep-links into the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/rostrik_widget_background"
    android:gravity="center_vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/widget_accent"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="14dp"
        android:background="@color/widget_accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="☀️ Day shift"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="Starts in 6d 1h"
            android:textColor="@color/widget_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Starts Wed, Jul 1 at 06:00"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
