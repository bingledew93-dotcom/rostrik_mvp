<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Exact-alarm capability, split by API level per Google's guidance for
         alarm-clock apps (audit F7):
           * 12/12L (31-32): SCHEDULE_EXACT_ALARM — pre-granted but USER-
             REVOCABLE via Settings → "Alarms & reminders"; a revocation makes
             setAlarmClock throw (guarded → EXACT_ALARM_DENIED, surfaced by the
             Dashboard reliability banner). maxSdkVersion=32 keeps it off 13+.
           * 13+ (33+): USE_EXACT_ALARM — install-time and NON-revocable for
             apps whose core function is an alarm clock. Play policy restricts
             it to exactly this category; Rostrik qualifies. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets the alarm fire as a full-screen intent that wakes the lockscreen. -->
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Android 13+ runtime permission for displaying notifications at all. -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Needed by Rostrik's BootReceiver to re-arm pending alarms after a
         reboot. Without it, every scheduled alarm is silently dropped on
         power-cycle.
         RECEIVE_BOOT_COMPLETED is sufficient for ACTION_BOOT_COMPLETED
         and ACTION_LOCKED_BOOT_COMPLETED on all supported Android
         versions — there is no separate "locked boot" permission. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Required so the alarm can fire while the device is dozing/asleep, and
         for the AlarmAudioEngine's PARTIAL_WAKE_LOCK that keeps the CPU
         feeding the audio buffer while the screen is off. -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK"/>
    <!-- Lets the alarm channel vibrate. -->
    <uses-permission
        android:name="android.permission.VIBRATE"/>
    <!-- AlarmAudioService runs the custom fire-time tone as a foreground
         service so the OS keeps the PROCESS alive while a show-when-locked
         WakeUpScreen is occluded by the notification shade (the Android-14
         keyguard Silence Bug — a process-scoped player alone died with the
         reaped process). Android 14 (targetSdk 34) requires the typed
         permission alongside the generic one. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <!-- Custom ringtone playback at FIRE TIME (audit F7 — reviewed and KEPT):
         the vault flow copies picked files into app storage (no permission
         needed), but the SYSTEM-picker flow stores a content:// URI that can
         point at user-added audio on shared storage. AlarmAudioService opens
         that URI at 3am with no activity result grant in scope — without this
         permission the open fails and the engine falls back to the bundled
         classic tone (alarm still rings, wrong sound). -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- Pre-Android-13 fallback. Capped at API 32 so it is NOT requested on
         33+, where READ_MEDIA_AUDIO supersedes it and a broad storage grant
         would be denied anyway — i.e. it degrades gracefully on newer OSes. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <application
        android:label="Rostrik"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- android:screenOrientation="portrait" is a hard OS-level lock so
             devices/OEM ROMs that ignore Flutter's
             SystemChrome.setPreferredOrientations can't rotate the app into the
             landscape overflow. Mirrors the UCropActivity lock below. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Rostrik's boot-recovery receiver. Enqueues AlarmSyncWorker, which
             spins up a headless Flutter engine and runs syncAlarms() against the
             Hive source of truth — so any divergence between Hive and the OS
             alarm set (manual app data clear, OEM deep-sleep purge, partial-
             write from a previous crash) is reconciled automatically.

             android:exported="true" because BOOT_COMPLETED is a system
             broadcast and Android requires the receiver to be exported to
             receive it. The receiver itself whitelists the actions it
             reacts to before doing any work, so a malicious app cannot
             trigger arbitrary work by faking other actions.

             android:directBootAware="true" lets the receiver's onReceive run
             during direct boot (before first unlock) on FBE
             (file-based-encryption) devices. NOTE: it cannot do useful work
             that early — WorkManager's own job DB AND our Hive boxes both
             live in CREDENTIAL-encrypted storage, which is unavailable until
             first unlock. An enqueue attempted from
             ACTION_LOCKED_BOOT_COMPLETED therefore throws and is caught/
             logged in BootReceiver (a deliberate no-op). The authoritative
             trigger is ACTION_BOOT_COMPLETED, which on FBE devices fires
             AFTER unlock — by then CE storage (hence Hive) is readable and
             the Worker runs. LOCKED_BOOT_COMPLETED is kept only so the
             receiver is wired as early as the platform allows for any future
             direct-boot-aware work; today it intentionally does nothing. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action
                    android:name="android.intent.action.BOOT_COMPLETED"/>
                <action
                    android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action
                    android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action
                    android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action
                    android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
                <!-- Clock-change recovery: armed alarms are epoch instants
                     derived from LOCAL wall time; a timezone hop or manual
                     clock edit strands them at the wrong local time until
                     re-synced. Both actions are implicit-broadcast EXCEPTIONS
                     for clock apps, so manifest delivery works on API 26+. -->
                <action
                    android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action
                    android:name="android.intent.action.TIME_SET"/>
            </intent-filter>
        </receiver>
        <!-- Receiver AlarmManager dispatches to when an exact alarm fires. The
             Dart scheduler builds an EXPLICIT PendingIntent targeting this
             component (action ALARM_FIRE), so it needs NO intent-filter and
             MUST stay exported="false" — the system still delivers an explicit
             PendingIntent to a private receiver, while keeping it private blocks
             any other app from spoofing a fire. This is the entry point of the
             custom native alarm path that replaces flutter_local_notifications:
             onReceive takes a WakeLock, starts AlarmAudioService, and posts the
             full-screen-intent notification that launches AlarmActivity. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false"/>
        <!-- Foreground service that owns FIRING-ALARM custom audio. type
             mediaPlayback raises the process to foreground oom-priority so a
             ringing alarm survives the keyguard occluding/destroying the
             show-when-locked WakeUpScreen activity. Not exported — started
             only by MainActivity (in-process) while it is foreground. -->
        <service
            android:name=".AlarmAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>
        <!-- Native (NON-Flutter) full-screen alarm screen, launched by
             AlarmReceiver's full-screen-intent notification. Its OWN task
             (taskAffinity="") + excludeFromRecents so a dismiss can
             finishAndRemoveTask with no zombie alarm screen lingering over the
             keyguard. showWhenLocked / turnScreenOn render it over the lock
             screen and wake the display (matching runtime flags in onCreate for
             older API paths). Not exported — only our own FSI PendingIntent
             starts it. Framework theme because it extends android.app.Activity,
             not a Flutter/AppCompat Activity. -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"/>
        <!-- image_cropper (uCrop) crop UI, used by the Phase-6 OCR roster
             scanner's tight-crop step. Without this declaration uCrop throws
             ActivityNotFoundException at runtime. uCrop requires an AppCompat
             theme (pulled in transitively by the plugin). -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: lets us resolve a browser for the Privacy Policy /
             Terms of Use https links on Android 11+ (package visibility). -->
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <data
                android:scheme="https"/>
        </intent>
    </queries>
</manifest>